    agent any
    stages{
        stage('Build'){
            steps{
                echo "Building the project"
            }
        }
        stage('Test'){
            steps{
                echo "Running tests"
            }
        }
        stage('Deployment'){ 
            steps{
                echo "Deploying the project....."
                echo "Deployment completed successfully"
            }
        }        
        }
    }
